+++ b/tests/review-20261121-host.spec.ts
@@ -0,0 +1,228 @@
+/**
+ * 2026-11-21 review repros (host side). Each case asserts the CURRENT
+ * behavior the review flagged — a green run is the reproduction, not a pass
+ * of the intended contract.
+ *
+ * R-A — an unrelated grant write terminates an in-flight `remote_bash` as
+ *   'revoked'. `RemoteControlPlane.revision` (src/remote/plane.ts:64) is ONE
+ *   counter per plane: `persistGrants` bumps it for ANY primary's grant
+ *   write (:163), `admit()` hands it to the operation identity (:271), and
+ *   `runRemoteCommand`'s `checkGrant` compares it against the revision
+ *   captured at launch (src/remote/exec.ts:225-232). Registering a
+ *   different remote root — under the same primary or a different one —
+ *   moves the revision and kills a running command whose own grant never
+ *   changed.
+ *
+ * R-B — "Add connection" with an existing environmentId silently replaces
+ *   that connection. `sshEnvironmentSave` filters by id and pushes the
+ *   draft (src/remote/personal-endpoints.ts:269-275) with no
+ *   create-vs-update distinction, and the Add wizard auto-slugs the id from
+ *   the display name without a uniqueness check — a fresh Add for "prod"
+ *   retargets every Workspace binding that already named "prod".
+ */
+import { chmodSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import type { Context } from '@deepseek-ai/cordis'
+import Sessions, { SessionId } from '@deepseek-ai/dsh-session'
+import Projections from '@deepseek-ai/dsh-session-projection'
+import Policy from '@deepseek-ai/dsh-sandbox-policy'
+import { runRemoteCommand, type RemoteExecutionBackend, type RemoteProcessHandle } from '../src/remote/exec.ts'
+import { handlePersonalEndpoint } from '../src/remote/personal-endpoints.ts'
+import type { ExecFile } from '../src/remote/personal/credentials.ts'
+import type { SshCall, SshStateView } from '../src/remote/personal-contract.ts'
+import { savePersonalConfig, type PersonalConfig } from '../src/remote/personal/config.ts'
+import type { MultiRootRegistry } from '../src/registry.ts'
+import { mountRegistryStack, type RegistryStack } from './support/registry-stack.ts'
+import { createFixtureWorkspace, type FixtureWorkspace } from './support/temp-workspace.ts'
+
+let fixture: FixtureWorkspace
+let stacks: RegistryStack[]
+beforeEach(() => { fixture = createFixtureWorkspace('review-20261121'); stacks = [] })
+afterEach(async () => { for (const stack of stacks.reverse()) await stack.dispose(); fixture.dispose() })
+
+const REF = { environmentId: 'build-01', rootId: 'app' }
+const OTHER_REF = { environmentId: 'build-01', rootId: 'data' }
+const DEPLOYMENT = { shell: ['/bin/sh', '-c'], env: { PATH: '/bin' }, maxTimeoutMs: 60_000, stdoutLimit: 64, stderrLimit: 64, terminateGraceMs: 10 } as const
+
+// Same shape as tests/remote-exec.spec.ts, plus a second binding under the
+// same primary (OTHER_REF) and a third under a second primary root — the
+// manifest authorizes them all; only `app` is ever registered.
+function manifestFile() {
+  const path = join(fixture.base, 'deploy.json')
+  writeFileSync(path, JSON.stringify({
+    schemaVersion: 1, configVersion: 'cfg-1',
+    environments: [{ environmentId: 'build-01', platform: 'linux', account: 'ci', hostKey: `SHA256:${'A'.repeat(43)}`, namespace: 'ns', transport: 'sftp', helper: null, connection: { host: 'vps' }, credentialIsolation: 'unattested' }],
+    bindings: [
+      { primary: fixture.workspace, environmentId: 'build-01', rootId: 'app', path: '/work/app', actions: ['read', 'write', 'exec'] },
+      { primary: fixture.workspace, environmentId: 'build-01', rootId: 'data', path: '/work/data', actions: ['read', 'write', 'exec'] },
+      { primary: fixture.outside, environmentId: 'build-01', rootId: 'app', path: '/work/app', actions: ['read', 'write', 'exec'] },
+    ],
+  }))
+  chmodSync(path, 0o600)
+  return path
+}
+
+class FakeHandle implements RemoteProcessHandle {
+  readonly started = Promise.resolve()
+  terminateCalls = 0
+  private readonly exit = Promise.withResolvers<{ exitCode: number | null; signal: string | null }>()
+  readonly exited = this.exit.promise
+  constructor(private readonly sink: { stdout(c: Uint8Array): void; stderr(c: Uint8Array): void }) {}
+  emit(chunk: string, err = false) { this.sink[err ? 'stderr' : 'stdout'](new TextEncoder().encode(chunk)) }
+  finish(exitCode = 0, signal: string | null = null) { this.exit.resolve({ exitCode, signal }) }
+  terminate() { this.terminateCalls++ }
+  async waitForExit() { return true }
+}
+
+function fakeBackend() {
+  const state = { generation: 'gen-1', handles: [] as FakeHandle[] }
+  const backend: RemoteExecutionBackend = {
+    deployment: DEPLOYMENT,
+    async confine(argv) { return { argv, enforcement: 'full' as const, generation: state.generation } },
+    currentGeneration: () => state.generation,
+    spawn(_argv, _options, sink) {
+      const handle = new FakeHandle(sink)
+      state.handles.push(handle)
+      return handle
+    },
+  }
+  return { backend, state }
+}
+
+async function mount() {
+  const stack = await mountRegistryStack(join(fixture.base, 'store'), {
+    remoteEnvironments: { enabled: true, manifestPath: manifestFile() },
+  }, {
+    allowUserOwnedRemoteManifestForTesting: true,
+    beforeGate: async ctx => {
+      await ctx.plugin(Projections)
+      await ctx.plugin(Sessions)
+      await ctx.plugin(Policy, { mode: 'workspace-write', workspaceRoot: fixture.workspace })
+    },
+  })
+  stacks.push(stack)
+  stack.registry.setRemoteEndpointVerifier({ verify: async (_e, b) => ({ platform: 'linux' as const, target: { kind: 'path' as const, value: b.path } }) })
+  await stack.registry.addRemote(fixture.workspace, REF)
+  return stack
+}
+
+let seq = 0
+const sessionOf = (stack: RegistryStack) =>
+  stack.ctx.sessions.create(SessionId(`review-${++seq}`), { meta: { cwd: fixture.workspace } })
+async function waitHandles(state: { handles: FakeHandle[] }, count = 1) {
+  for (let i = 0; i < 400 && state.handles.length < count; i++) await new Promise(resolve => setTimeout(resolve, 5))
+  if (state.handles.length < count) throw new Error(`expected ${count} spawned handle(s), got ${state.handles.length}`)
+}
+async function waitTerminate(handle: FakeHandle) {
+  // The grant check poll interval is 250ms; the kill lands shortly after it.
+  for (let i = 0; i < 600 && handle.terminateCalls === 0; i++) await new Promise(resolve => setTimeout(resolve, 5))
+}
+const run = (stack: RegistryStack, backend: RemoteExecutionBackend) =>
+  runRemoteCommand(stack.registry, () => backend, {
+    session: sessionOf(stack), environmentId: REF.environmentId, rootId: REF.rootId, command: 'sleep 60', timeoutMs: 30_000,
+  } as never, 'remote_bash', new AbortController().signal)
+
+describe.skipIf(process.platform === 'win32')('R-A: an unrelated grant write terminates an in-flight remote_bash', () => {
+  it('registering a second root under the SAME primary kills the running command as revoked', async () => {
+    const stack = await mount()
+    const { backend, state } = fakeBackend()
+    const pending = run(stack, backend)
+    await waitHandles(state)
+    // `data` shares the environment and the primary; the command's own grant
+    // for `app` is never touched — yet the revision bump ends it.
+    await stack.registry.addRemote(fixture.workspace, OTHER_REF)
+    await waitTerminate(state.handles[0]!)
+    expect(state.handles[0]!.terminateCalls).toBe(1)
+    state.handles[0]!.finish(0)
+    await expect(pending).resolves.toMatchObject({ status: 'scope-exited', exitCode: 0, termination: 'revoked' })
+    // The grant is still live: the next command on the same endpoint runs.
+    const again = run(stack, backend)
+    await waitHandles(state, 2)
+    state.handles[1]!.finish(0)
+    await expect(again).resolves.toMatchObject({ status: 'scope-exited', exitCode: 0 })
+  })
+
+  it('registering a root under a DIFFERENT primary kills the running command the same way', async () => {
+    const stack = await mount()
+    const { backend, state } = fakeBackend()
+    const pending = run(stack, backend)
+    await waitHandles(state)
+    // `fixture.outside` is a second primary root with its own manifest
+    // binding; the plane revision is not per-primary, so this write still
+    // moves the revision the running command pinned.
+    await stack.registry.addRemote(fixture.outside, REF)
+    await waitTerminate(state.handles[0]!)
+    expect(state.handles[0]!.terminateCalls).toBe(1)
+    state.handles[0]!.finish(0)
+    await expect(pending).resolves.toMatchObject({ status: 'scope-exited', exitCode: 0, termination: 'revoked' })
+  })
+})
+
+/** The personal-mode world of tests/remote-personal-ops.spec.ts: a tmp store plus a stub registry. */
+const dirs: string[] = []
+const tmp = (): string => { const dir = mkdtempSync(join(tmpdir(), 'mrfw-review-')); dirs.push(dir); return dir }
+afterEach(() => { for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true }) })
+
+const world = () => {
+  const dir = tmp()
+  const personalPath = join(dir, 'remote-personal.json')
+  const credentialRoot = join(dir, 'cred')
+  const registry = {
+    remoteEnabled: true,
+    remoteMode: 'personal',
+    remotePersonalPath: personalPath,
+    remoteCredentialRoot: credentialRoot,
+    refreshRemotePersonal: async () => {},
+  } as unknown as MultiRootRegistry
+  return { registry, personalPath, credentialRoot }
+}
+
+describe.skipIf(process.platform === 'win32')('R-B: a fresh Add with an existing environmentId silently replaces that connection', () => {
+  it('re-saving "prod" against a new host succeeds and the Workspace binding follows it', async () => {
+    const { registry, personalPath } = world()
+    await savePersonalConfig(personalPath, { schemaVersion: 2, revision: 0, environments: [], bindings: [] } satisfies PersonalConfig, 0)
+    const fingerprint = `SHA256:${'B'.repeat(43)}`
+    const exec: ExecFile = async (file, args) => {
+      if (file === 'ssh-keyscan') return { stdout: `${args[args.length - 1]} ssh-ed25519 AAAAKEY\n`, stderr: '' }
+      if (file === 'ssh-keygen') return { stdout: `256 ${fingerprint} (ED25519)\n`, stderr: '' }
+      return { stdout: '', stderr: '' }
+    }
+    const call = async (payload: SshCall) =>
+      await handlePersonalEndpoint(undefined as never as Context, registry, '/w', payload, { exec }) as SshStateView
+    // The Add wizard's draft for "Production": the id is auto-slugged from the name.
+    const draft = (hostname: string) => ({
+      environmentId: 'prod', platform: 'linux' as const, displayName: 'Production',
+      endpoint: { hostname, port: 22, user: 'deploy' },
+      credential: { kind: 'managed' as const, credentialId: 'aabbccddeeff' },
+    })
+
+    // The original Add: scan host-a, save prod -> host-a.example.
+    const scanA = await handlePersonalEndpoint(undefined as never as Context, registry, '/w',
+      { endpoint: 'sshHostKeyScan', sessionId: 's', hostname: 'host-a.example', port: 22 }, { exec }) as { token: string }
+    const added = await call({ endpoint: 'sshEnvironmentSave', sessionId: 's', revision: 0,
+      environment: draft('host-a.example'), fingerprint, hostKeyToken: scanA.token })
+    expect(added.environments).toHaveLength(1)
+    expect(added.environments[0]!.endpoint.hostname).toBe('host-a.example')
+
+    // A Workspace Root binding names prod.
+    const bound = await call({ endpoint: 'sshBindingSave', sessionId: 's', revision: 1,
+      binding: { environmentId: 'prod', path: '/srv/app', actions: ['read'] } })
+    expect(bound.bindings).toMatchObject([{ environmentId: 'prod', rootId: 'app', path: '/srv/app' }])
+
+    // A second Add wizard run for a DIFFERENT host auto-slugs the same id
+    // "prod" and saves exactly like a create: new scan token, no update flag.
+    const scanB = await handlePersonalEndpoint(undefined as never as Context, registry, '/w',
+      { endpoint: 'sshHostKeyScan', sessionId: 's', hostname: 'host-b.example', port: 22 }, { exec }) as { token: string }
+    const replaced = await call({ endpoint: 'sshEnvironmentSave', sessionId: 's', revision: 2,
+      environment: draft('host-b.example'), fingerprint, hostKeyToken: scanB.token })
+
+    // CURRENT behavior: the "create" overwrites in place — one environment
+    // named prod, now pointing at host-b, and the Workspace binding that
+    // referenced prod silently retargeted to the new host.
+    expect(replaced.environments).toHaveLength(1)
+    expect(replaced.environments[0]).toMatchObject({ environmentId: 'prod', endpoint: { hostname: 'host-b.example' } })
+    expect(replaced.bindings).toMatchObject([{ environmentId: 'prod', rootId: 'app', path: '/srv/app' }])
+  })
+})
