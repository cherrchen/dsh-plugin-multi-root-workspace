+// @vitest-environment jsdom
+import { createElement } from 'react'
+import { act, cleanup, render, screen } from '@testing-library/react'
+import { afterEach, it, expect } from 'vitest'
+import { SshManagementDialog } from '../src/client/ssh-panel.tsx'
+
+afterEach(cleanup)
+it('review: an old session response replaces the new session bindings', async () => {
+  const a = Promise.withResolvers<any>(), b = Promise.withResolvers<any>()
+  const state = (name: string) => ({ mode: 'personal', enabled: true, linked: true, revision: 1, credentials: [], environments: [],
+    bindings: [{ primary: '/' + name, environmentId: 'env', rootId: name, path: '/remote/' + name, actions: ['read'] }] })
+  const props = { initialTab: 'connections', ssh: { state: (s: string) => s === 'a' ? a.promise : b.promise },
+    sessionId: 'a', custodyMode: 'personal', status: { state: 'ready' }, endpoints: [], roots: undefined,
+    remoteMode: undefined, onClose() {}, onChanged() {}, t: (key: string) => key }
+  const view = render(createElement(SshManagementDialog, props as any))
+  view.rerender(createElement(SshManagementDialog, { ...props, sessionId: 'b' } as any))
+  await act(async () => { b.resolve(state('project-b')); await b.promise })
+  expect(screen.getByText('/remote/project-b')).toBeTruthy()
+  await act(async () => { a.resolve(state('project-a')); await a.promise })
+  expect(screen.getByText('/remote/project-a')).toBeTruthy()
+  expect(screen.queryByText('/remote/project-b')).toBeNull()
+})
